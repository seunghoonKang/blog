---
interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface AdjacentNote {
  title: string;
  href: string;
}

interface Props {
  frontmatter: {
    title: string;
    author: string;
    description: string;
    pubDate: Date;
    image?: {
      url: string;
      alt: string;
    };
    tags: string[];
  };
  sidebarHeadings: MarkdownHeading[];
  /** 더 오래된 글 */
  prevNote?: AdjacentNote;
  /** 더 최근 글 */
  nextNote?: AdjacentNote;
  /** 뒤로가기 링크 */
  backHref?: string;
  noindex?: boolean;
  comments?: boolean;
  shareUrl?: string;
  canonicalPathSlug?: string;
  canonicalUrl?: string;
}

import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import NoteThumbnail from "../components/NoteThumbnail.astro";
import ReadingNavigator from "../components/ReadingNavigator.astro";
import ShareNoteButton from "../components/ShareNoteButton.astro";
import { formatArticleDate } from "../utils/formatDate";

const {
  frontmatter,
  sidebarHeadings,
  prevNote,
  nextNote,
  backHref = "/",
  noindex = false,
  comments = false,
  shareUrl,
  canonicalPathSlug,
  canonicalUrl,
} = Astro.props;

const articleImageUrl = frontmatter.image
  ? new URL(frontmatter.image.url, Astro.url).href
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  ...(articleImageUrl ? { image: [articleImageUrl] } : {}),
  mainEntityOfPage: canonicalUrl ?? Astro.url.href,
};
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  ogType="article"
  pubDate={frontmatter.pubDate}
  noindex={noindex}
  canonicalUrl={canonicalUrl}
>
  <ReadingNavigator headings={sidebarHeadings} />

  <article class="appear">
    <header>
      <a
        href={backHref}
        class="inline-flex items-center gap-1 text-[13px] text-muted transition-colors hover:text-[var(--foreground)]"
      >
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        뒤로가기
      </a>

      <h1 class="mt-4 text-xl leading-[1.4] font-semibold">
        {frontmatter.title}
      </h1>

      <div class="mt-2 flex items-center justify-between gap-3">
        <p class="text-muted-strong text-sm leading-[1.5]">
          <time datetime={frontmatter.pubDate.toISOString()}>
            {formatArticleDate(frontmatter.pubDate)}
          </time>
        </p>
        {shareUrl && <ShareNoteButton shareUrl={shareUrl} />}
      </div>

      {
        frontmatter.image && (
          <div class="mt-8">
            <NoteThumbnail
              image={frontmatter.image}
              title={frontmatter.title}
              variant="hero"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
    </header>

    <div class="prose prose-reading mt-10 dark:prose-invert" id="article-content">
      <slot />
    </div>
  </article>

  {
    (prevNote || nextNote) && (
      <nav
        class="mt-16 grid grid-cols-2 gap-6 border-t border-[var(--border)] pt-6"
        aria-label="이전글 / 다음글"
      >
        {prevNote ? (
          <a href={prevNote.href} class="group flex flex-col gap-1">
            <span class="text-xs text-muted">← 이전글</span>
            <span class="text-sm leading-[1.5] font-medium group-hover:underline">
              {prevNote.title}
            </span>
          </a>
        ) : (
          <p class="text-sm text-muted">이전글이 없습니다</p>
        )}
        {nextNote ? (
          <a href={nextNote.href} class="group flex flex-col items-end gap-1 text-right">
            <span class="text-xs text-muted">다음글 →</span>
            <span class="text-sm leading-[1.5] font-medium group-hover:underline">
              {nextNote.title}
            </span>
          </a>
        ) : (
          <p class="text-right text-sm text-muted">다음글이 없습니다</p>
        )}
      </nav>
    )
  }

  {
    comments && (
      <section class="mt-14" aria-label="댓글">
        <Giscus />
        <p class="mt-4 text-sm text-muted">
          GitHub 계정으로 로그인한 뒤 댓글을 남길 수 있습니다.
        </p>
      </section>
    )
  }
</BaseLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(articleJsonLd)}
/>

{
  canonicalPathSlug && (
    <script define:vars={{ canonicalPathSlug }}>
      const target =
        `/notes/${canonicalPathSlug}` + location.search + location.hash;
      const decodedPath = decodeURI(location.pathname);
      if (decodedPath !== location.pathname) {
        history.replaceState(
          history.state,
          "",
          decodedPath + location.search + location.hash
        );
      }
      if (
        location.pathname !== target &&
        decodeURI(location.pathname) !== target
      ) {
        history.replaceState(history.state, "", target);
      }
    </script>
  )
}

<script>
  import { smoothScroll } from "../utils/smoothScroll";
  smoothScroll();

  function initTocActiveState() {
    const tocLinks = document.querySelectorAll<HTMLElement>(
      "#reading-navigator [data-toc-slug]"
    );
    if (tocLinks.length === 0) return;

    const slugs = new Set<string>();
    for (const link of tocLinks) {
      if (link.dataset.tocSlug) slugs.add(link.dataset.tocSlug);
    }

    const headings = [...slugs]
      .map(slug => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length === 0) return;

    const setActive = (slug: string | null) => {
      for (const link of tocLinks) {
        link.classList.toggle("is-active", link.dataset.tocSlug === slug);
      }
    };

    const observer = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .toSorted((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0 && visible[0].target.id) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: [0, 0.25, 0.5, 1] }
    );

    for (const heading of headings) observer.observe(heading);
  }

  initTocActiveState();
</script>
