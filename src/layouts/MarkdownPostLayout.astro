---
interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  frontmatter: {
    title: string;
    author: string;
    description: string;
    pubDate: Date;
    image?: {
      url: string;
      alt: string;
    };
    tags: string[];
  };
  sidebarHeadings: MarkdownHeading[];
  noindex?: boolean;
  comments?: boolean;
}

import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";

const { frontmatter, sidebarHeadings, noindex = false, comments = false } =
  Astro.props;

const articleImageUrl = frontmatter.image
  ? new URL(frontmatter.image.url, Astro.url).href
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  ...(articleImageUrl ? { image: [articleImageUrl] } : {}),
  mainEntityOfPage: Astro.url.href,
};
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  ogType="article"
  pubDate={frontmatter.pubDate}
  noindex={noindex}
>
  <div
    class="relative mx-auto max-w-screen-lg px-[var(--space-content)] py-[var(--space-section-y)]"
  >
    <div class="md:flex md:gap-[var(--space-section-y)]">
      <!-- 메인 콘텐츠 영역 -->
      <article class="min-w-0 flex-1">
        <!-- 헤더 섹션 -->
        <header class="mb-[var(--space-section-y)]">
          <h1 class="mb-[var(--space-card)] text-4xl font-bold">
            {frontmatter.title}
          </h1>

          <div
            class="my-2 flex flex-wrap justify-between gap-2 text-sm text-gray-500 dark:text-gray-400"
          >
            <p class="italic">{frontmatter.description}</p>
            <time datetime={frontmatter.pubDate.toISOString()}>
              {
                frontmatter.pubDate.toLocaleDateString("ko-KR", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </time>
          </div>

          {
            frontmatter.image && (
              <div class="my-6 overflow-hidden rounded-lg">
                <img
                  src={frontmatter.image.url}
                  alt={frontmatter.image.alt}
                  fetchpriority="high"
                  loading="eager"
                  class="w-full max-h-[70vh] h-auto object-contain"
                />
              </div>
            )
          }
        </header>

        <!-- 마크다운 콘텐츠 -->
        <div class="prose max-w-none dark:prose-invert" id="article-content">
          <slot />
        </div>

        {
          comments && (
            <section
              class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700"
              aria-label="댓글"
            >
              <h2 class="mb-4 text-xl font-semibold">댓글</h2>
              <Giscus />
              <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
                GitHub 계정으로 로그인한 뒤 댓글을 남길 수 있습니다.
              </p>
            </section>
          )
        }
      </article>

      <!-- 목차 사이드바 (넓은 화면에서만 표시) -->

      {
        sidebarHeadings.length > 0 && (
          <aside class="sticky top-32 hidden max-h-[calc(100dvh-10rem)] w-64 flex-shrink-0 overflow-y-auto border-l border-l-gray-400 pl-3 md:block">
            <h2 class="mb-4 text-xl font-semibold">목차</h2>
            <nav>
              <ul class="space-y-2">
                {sidebarHeadings.map(heading => (
                  <li
                    class={
                      heading.depth === 1
                        ? "pl-2"
                        : heading.depth === 2
                          ? "pl-6"
                          : heading.depth === 3
                            ? "pl-10"
                            : ""
                    }
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block text-sm text-[--tw-prose-code] transition-colors hover:text-blue-600"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(articleJsonLd)}
/>

<script>
  import { smoothScroll } from "../utils/smoothScroll";
  smoothScroll();
</script>
