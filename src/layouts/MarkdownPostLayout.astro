---
interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedNote {
  title: string;
  slug: string;
}

interface Props {
  frontmatter: {
    title: string;
    author: string;
    description: string;
    pubDate: Date;
    image?: {
      url: string;
      alt: string;
    };
    tags: string[];
  };
  sidebarHeadings: MarkdownHeading[];
  relatedNotes?: RelatedNote[];
  noindex?: boolean;
  comments?: boolean;
  shareUrl?: string;
  canonicalPathSlug?: string;
  canonicalUrl?: string;
}

import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import NoteThumbnail from "../components/NoteThumbnail.astro";
import ShareNoteButton from "../components/ShareNoteButton.astro";
import { formatArticleDate } from "../utils/formatDate";

const {
  frontmatter,
  sidebarHeadings,
  relatedNotes = [],
  noindex = false,
  comments = false,
  shareUrl,
  canonicalPathSlug,
  canonicalUrl,
} = Astro.props;

const authorName = frontmatter.author?.trim();

const articleImageUrl = frontmatter.image
  ? new URL(frontmatter.image.url, Astro.url).href
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate.toISOString(),
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  ...(articleImageUrl ? { image: [articleImageUrl] } : {}),
  mainEntityOfPage: canonicalUrl ?? Astro.url.href,
};
---

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image}
  ogType="article"
  pubDate={frontmatter.pubDate}
  noindex={noindex}
  canonicalUrl={canonicalUrl}
>
  <div
    class="relative mx-auto max-w-screen-lg px-[var(--space-content)] py-[var(--space-section-y)]"
  >
    <div class="md:flex md:gap-[var(--space-section-y)]">
      <article class="min-w-0 flex-1">
        <header class="mb-[var(--space-section-y)] max-w-[42rem]">
          <h1 class="text-4xl font-bold tracking-tight">
            {frontmatter.title}
          </h1>

          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <p class="text-sm text-muted">
              <time datetime={frontmatter.pubDate.toISOString()}>
                {formatArticleDate(frontmatter.pubDate)}
              </time>
              {
                authorName && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <span>{authorName}</span>
                  </>
                )
              }
            </p>
            {shareUrl && <ShareNoteButton shareUrl={shareUrl} />}
          </div>

          {
            frontmatter.description && (
              <p class="article-lead">{frontmatter.description}</p>
            )
          }

          {
            frontmatter.image && (
              <div class="my-6">
                <NoteThumbnail
                  image={frontmatter.image}
                  title={frontmatter.title}
                  variant="hero"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )
          }
        </header>

        <div
          class="prose prose-reading dark:prose-invert"
          id="article-content"
        >
          <slot />
        </div>

        {
          frontmatter.tags?.length > 0 && (
            <div class="prose-reading mt-10 flex flex-wrap gap-2">
              {frontmatter.tags.map(tag => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>
          )
        }

        {
          relatedNotes.length > 0 && (
            <section
              class="prose-reading mt-12 border-t border-[var(--border)] pt-8"
              aria-labelledby="related-notes-heading"
            >
              <h2 id="related-notes-heading" class="text-xl font-semibold">
                다른 노트
              </h2>
              <ul class="mt-4 space-y-3">
                {relatedNotes.map(related => (
                  <li>
                    <a
                      href={`/notes/${related.slug}`}
                      class="font-medium text-[var(--accent)] underline-offset-2 hover:underline"
                    >
                      {related.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          comments && (
            <section
              class="prose-reading mt-12 border-t border-[var(--border)] pt-8"
              aria-label="댓글"
            >
              <h2 class="mb-4 text-xl font-semibold">댓글</h2>
              <Giscus />
              <p class="mt-4 text-sm text-muted">
                GitHub 계정으로 로그인한 뒤 댓글을 남길 수 있습니다.
              </p>
            </section>
          )
        }
      </article>

      {
        sidebarHeadings.length > 0 && (
          <aside class="sticky top-32 hidden max-h-[calc(100dvh-10rem)] w-64 shrink-0 overflow-y-auto border-l border-[var(--border)] pl-4 md:block">
            <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-muted">
              목차
            </h2>
            <nav id="toc-nav" aria-label="목차">
              <ul class="space-y-2">
                {sidebarHeadings.map(heading => (
                  <li
                    class={
                      heading.depth === 1
                        ? ""
                        : heading.depth === 2
                          ? "pl-3"
                          : heading.depth === 3
                            ? "pl-6"
                            : ""
                    }
                  >
                    <a
                      href={`#${heading.slug}`}
                      class="toc-link block text-sm"
                      data-toc-slug={heading.slug}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(articleJsonLd)}
/>

{
  canonicalPathSlug && (
    <script define:vars={{ canonicalPathSlug }}>
      const target =
        `/notes/${canonicalPathSlug}` + location.search + location.hash;
      const decodedPath = decodeURI(location.pathname);
      if (decodedPath !== location.pathname) {
        history.replaceState(
          history.state,
          "",
          decodedPath + location.search + location.hash
        );
      }
      if (
        location.pathname !== target &&
        decodeURI(location.pathname) !== target
      ) {
        history.replaceState(history.state, "", target);
      }
    </script>
  )
}

<script>
  import { smoothScroll } from "../utils/smoothScroll";
  smoothScroll();

  function initTocActiveState() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
      "#toc-nav .toc-link[data-toc-slug]"
    );
    if (tocLinks.length === 0) return;

    const slugToLink = new Map<string, HTMLAnchorElement>();
    for (const link of tocLinks) {
      const slug = link.dataset.tocSlug;
      if (slug) slugToLink.set(slug, link);
    }

    const headings = [...slugToLink.keys()]
      .map(slug => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length === 0) return;

    const setActive = (slug: string | null) => {
      for (const link of tocLinks) {
        link.classList.toggle("is-active", link.dataset.tocSlug === slug);
      }
    };

    const observer = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .toSorted((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0 && visible[0].target.id) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: [0, 0.25, 0.5, 1] }
    );

    for (const heading of headings) observer.observe(heading);
  }

  initTocActiveState();
</script>
