---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "페이지를 찾을 수 없습니다";
const description =
  "요청하신 페이지가 존재하지 않거나, 더 이상 제공되지 않습니다.";
---

<BaseLayout pageTitle={pageTitle} description={description} noindex>
  <section
    class="mx-auto flex max-w-screen-md flex-col items-start gap-4 px-[var(--space-content)] py-[var(--space-section-y)]"
  >
    <p class="text-sm text-gray-500 dark:text-gray-400">404</p>
    <h1 class="text-3xl font-bold">{pageTitle}</h1>
    <p class="text-base text-gray-600 dark:text-gray-300">{description}</p>
    <div class="mt-4 flex gap-3">
      <a
        href="/"
        class="rounded-md px-3 py-2 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black hover:dark:bg-white/15 hover:dark:text-white"
        >홈으로</a
      >
      <a
        href="/notes"
        class="rounded-md px-3 py-2 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black hover:dark:bg-white/15 hover:dark:text-white"
        >노트 보기</a
      >
    </div>
  </section>
</BaseLayout>
