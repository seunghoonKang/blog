---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "글";
const allPosts = await getCollection("posts");

const groupedPosts = Object.groupBy(allPosts, post => {
  return new Date(post.data.pubDate).getFullYear();
});

const sortedGroupEntries = Object.entries(groupedPosts).sort(
  ([a], [b]) => Number(b) - Number(a)
);
---

<BaseLayout pageTitle={pageTitle} noindex>
  <div class="px-[var(--space-content)]">
  {
    sortedGroupEntries.map(([year, posts]) => (
      <section>
        <div class="year-heading mt-[var(--space-section-y)] flex items-baseline gap-2">
          <h2 class="text-2xl font-bold">{year}</h2>
          <span class="text-sm text-muted">({posts?.length})</span>
        </div>
        <ul class="mt-4 divide-y divide-[var(--border)]">
          {posts
            ?.toSorted(
              (a, b) =>
                new Date(b.data.pubDate).getTime() -
                new Date(a.data.pubDate).getTime()
            )
            .map(post => (
              <li>
                <a href={`/posts/${post.id}`} class="story-row group">
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-semibold group-hover:text-[var(--accent)]">
                      {post.data.title}
                    </span>
                    <span class="shrink-0 text-sm text-muted">
                      {new Date(post.data.pubDate).toLocaleDateString()}
                    </span>
                  </div>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  </div>
</BaseLayout>
