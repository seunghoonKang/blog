---
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";
import {
  getPosts,
  getNoteContent,
  getNotePathSlug,
  getNotePathSlugs,
  buildNoteShareUrl,
} from "../../utils/notion";

export async function getStaticPaths() {
  const notes = await getPosts();
  return notes.flatMap(note =>
    getNotePathSlugs(note).map(slug => ({
      params: { slug },
      props: { note, canonicalPathSlug: getNotePathSlug(note) },
    }))
  );
}

const { note, canonicalPathSlug } = Astro.props;
// 최신순 정렬 기준: 다음글 = 더 최근 글, 이전글 = 더 오래된 글
const sortedNotes = (await getPosts()).toSorted(
  (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);
const index = sortedNotes.findIndex(n => n.id === note.id);
const toAdjacent = (n: (typeof sortedNotes)[number] | undefined) =>
  n ? { title: n.title, href: `/notes/${getNotePathSlug(n)}` } : undefined;
const nextNote = index > 0 ? toAdjacent(sortedNotes[index - 1]) : undefined;
const prevNote = index >= 0 ? toAdjacent(sortedNotes[index + 1]) : undefined;
const { content, headings } = await getNoteContent(note);

const sidebarHeadings = headings.filter(
  heading => heading.depth === 1 || heading.depth === 2 || heading.depth === 3
);

const shareUrl = buildNoteShareUrl(Astro.site ?? Astro.url, note);
const canonicalUrl = buildNoteShareUrl(Astro.site ?? Astro.url, note);
---

<MarkdownPostLayout
  frontmatter={{
    title: note.title,
    pubDate: note.pubDate,
    description: note.description,
    author: note.author,
    image: note.image,
    tags: note.tags,
  }}
  sidebarHeadings={sidebarHeadings}
  prevNote={prevNote}
  nextNote={nextNote}
  comments
  shareUrl={shareUrl}
  canonicalPathSlug={canonicalPathSlug}
  canonicalUrl={canonicalUrl}
>
  <div set:html={content} />
</MarkdownPostLayout>
