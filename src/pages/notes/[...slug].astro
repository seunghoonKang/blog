---
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";
import { getPosts, getNoteContent, titleToSlug } from "../../utils/notion";

export async function getStaticPaths() {
  const notes = await getPosts();
  return notes.map(note => ({
    params: { slug: titleToSlug(note.title) },
    props: { note },
  }));
}

const { note } = Astro.props;
const { content, headings } = await getNoteContent(note);

const sidebarHeadings = headings.filter(
  heading => heading.depth === 1 || heading.depth === 2 || heading.depth === 3
);
---

<MarkdownPostLayout
  frontmatter={{
    title: note.title,
    pubDate: note.pubDate,
    description: note.description,
    author: note.author,
    image: note.image,
    tags: note.tags,
  }}
  sidebarHeadings={sidebarHeadings}
>
  <div set:html={content} />
</MarkdownPostLayout>
