---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryListItem from "../../components/StoryListItem.astro";
import { getPosts } from "../../utils/notion";

const pageTitle = "노트";
const description = "개발과 배운 것을 기록한 노트 목록입니다.";

const notes = await getPosts();

const groupedNotes = Object.groupBy(notes, note => {
  return new Date(note.pubDate).getFullYear();
});

const sortedGroupEntries = Object.entries(groupedNotes).sort(
  ([a], [b]) => Number(b) - Number(a)
);
---

<BaseLayout pageTitle={pageTitle} description={description}>
  <div class="px-[var(--space-content)]">
    {
      sortedGroupEntries.map(([year, yearNotes]) => (
        <section class="mt-[var(--space-section-y)]">
          <div class="year-heading flex items-baseline gap-2">
            <h2 class="text-2xl font-bold">{year}</h2>
            <span class="text-sm text-muted">({yearNotes?.length})</span>
          </div>
          <ul class="mt-4 flex flex-col gap-2">
            {yearNotes
              ?.toSorted(
                (a, b) =>
                  new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
              )
              .map(note => (
                <li>
                  <StoryListItem note={note} />
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
