---
import StoryListItem from "./StoryListItem.astro";
import type { NoteData } from "../utils/notion";

interface Props {
  notes: NoteData[];
  heading?: string;
  headingId?: string;
  showReadMore?: boolean;
}

const {
  notes,
  heading = "Stories",
  headingId = "stories-heading",
  showReadMore = true,
} = Astro.props;
---

<section class="mt-[var(--space-section-y)]" aria-labelledby={headingId}>
  <h2 id={headingId} class="text-2xl font-bold">{heading}</h2>

  <ul class="mt-6 flex flex-col gap-2">
    {
      notes.map(note => (
        <li>
          <StoryListItem note={note} showReadMore={showReadMore} />
        </li>
      ))
    }
  </ul>
</section>
