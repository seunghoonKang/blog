---
import SocialLinks from "./SocialLinks.astro";

interface Props {
  width?: "narrow" | "wide";
}

const { width = "narrow" } = Astro.props;
---

<footer
  class:list={[
    "mx-auto flex w-full items-center justify-between gap-3 border-t border-[var(--border)] px-[var(--space-content)] pt-6 pb-10",
    width === "wide" ? "max-w-[720px]" : "max-w-[var(--content-max)]",
  ]}
>
  <p class="text-muted text-sm">© 2026 강승훈</p>
  <SocialLinks />
</footer>
