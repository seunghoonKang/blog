---
import MyLogo from "../assets/logo.svg";
import DarkIcon from "../assets/dark_icon.svg";
import LightIcon from "../assets/light_icon.svg";
---

<div class="flex flex-nowrap items-center justify-between">
  <a
    href="/"
    class="flex items-center rounded-md px-2 py-2 transition-all duration-300 ease-in-out hover:scale-105"
  >
    <MyLogo />
  </a>
  <div class="flex gap-8">
    <a
      href="/notes"
      class="flex items-center rounded-md px-2 transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black hover:dark:bg-white/15 hover:dark:text-white"
      >노트</a
    >
    <button
      id="toggle-theme"
      class="flex cursor-pointer items-center rounded-md transition-all duration-300 ease-in-out hover:scale-105"
      title="Toggle dark mode"
      aria-label="auto"
    >
      <span class="dark:hidden"><LightIcon /></span>
      <span class="hidden dark:inline"><DarkIcon /></span>
    </button>
  </div>
</div>
