---
import DarkIcon from "../assets/dark_icon.svg";
import LightIcon from "../assets/light_icon.svg";
---

<div class="flex flex-nowrap items-center justify-between">
  <a
    href="/"
    class="rounded-md px-2 py-2 text-sm font-semibold tracking-tight transition-opacity duration-200 hover:opacity-80"
  >
    seunghoonkang<span class="text-[var(--accent)]">.dev</span>
  </a>
  <div class="flex gap-8">
    <a
      href="/notes"
      class="flex items-center rounded-md px-2 text-sm transition-colors duration-200 hover:text-[var(--accent)]"
      >노트</a
    >
    <button
      id="toggle-theme"
      class="flex cursor-pointer items-center rounded-md transition-all duration-300 ease-in-out hover:scale-105"
      title="Toggle dark mode"
      aria-label="auto"
    >
      <span class="dark:hidden"><LightIcon /></span>
      <span class="hidden dark:inline"><DarkIcon /></span>
    </button>
  </div>
</div>
