---
/**
 * 화면 왼쪽에 제목 수만큼 짧은 가로줄을 쌓아 두고, 현재 읽는 섹션을 진하게 표시.
 * hover/focus 시 제목 목록 패널이 펼쳐진다. (lg 이상에서만 노출)
 */
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// 가장 얕은 제목 레벨을 기준으로 들여쓰기/줄 길이 계산
const minDepth = Math.min(...headings.map(h => h.depth));
const level = (depth: number) => Math.min(depth - minDepth, 2);
const barWidths = ["w-4", "w-3", "w-2"];
const indents = ["", "pl-3", "pl-6"];
---

{
  headings.length > 0 && (
    <nav
      id="reading-navigator"
      class="reading-nav fixed top-1/2 left-6 z-40 hidden -translate-y-1/2 lg:block"
      aria-label="목차"
    >
      {/* 접힌 상태: 가로줄 */}
      <ul class="reading-nav__bars flex flex-col gap-2 py-2" aria-hidden="true">
        {headings.map(h => (
          <li>
            <span
              class:list={[
                "reading-nav__bar block h-0.5 rounded-full",
                barWidths[level(h.depth)],
              ]}
              data-toc-slug={h.slug}
            />
          </li>
        ))}
      </ul>

      {/* 펼친 상태: 제목 목록 패널 */}
      <div class="reading-nav__panel">
        <ul class="flex flex-col gap-0.5">
          {headings.map(h => (
            <li class={indents[level(h.depth)]}>
              <a
                href={`#${h.slug}`}
                class="toc-link reading-nav__link block rounded-md px-2 py-1 text-[13px] leading-[1.45]"
                data-toc-slug={h.slug}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

<style>
  .reading-nav__bar {
    background-color: var(--border);
    transition: background-color 0.2s ease;
  }

  .reading-nav__bar.is-active {
    background-color: var(--foreground);
  }

  .reading-nav__panel {
    position: absolute;
    top: 50%;
    left: -0.5rem;
    width: 15rem;
    max-height: min(70vh, 32rem);
    overflow-y: auto;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background-color: var(--background);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 8px 24px rgb(0 0 0 / 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translate(-0.5rem, -50%);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0s linear 0.18s;
  }

  .reading-nav:hover .reading-nav__panel,
  .reading-nav:focus-within .reading-nav__panel {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .reading-nav:hover .reading-nav__bars,
  .reading-nav:focus-within .reading-nav__bars {
    opacity: 0;
  }

  .reading-nav__bars {
    transition: opacity 0.18s ease;
  }

  .reading-nav__link {
    color: var(--muted-foreground);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .reading-nav__link:hover {
    color: var(--foreground);
    background-color: var(--muted);
  }

  .reading-nav__link.is-active {
    color: var(--foreground);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-nav__panel,
    .reading-nav__bars {
      transition: none;
    }
  }
</style>
