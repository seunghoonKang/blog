---
interface Props {
  badge: string;
  period: string;
}

const { badge, period } = Astro.props;
---

<article class="career-soon" aria-label="다음 커리어 Coming soon">
  <div class="career-job-top">
    <div class="career-job-meta">{period}</div>
  </div>

  <div class="career-soon-panel">
    <div class="career-soon-blur" aria-hidden="true">
      <p class="career-soon-line career-soon-line--lg"></p>
      <p class="career-soon-line"></p>
      <p class="career-soon-line career-soon-line--md"></p>
      <ul class="career-soon-dots">
        <li></li>
        <li></li>
        <li></li>
      </ul>
    </div>
    <p class="career-soon-label">{badge}</p>
  </div>
</article>

<style>
  .career-soon {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .career-soon .career-job-top {
    justify-content: flex-end;
  }

  .career-soon-panel {
    position: relative;
    margin-top: 0.65rem;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--muted);
    min-height: 7.5rem;
  }

  .career-soon-blur {
    padding: 1rem 1.1rem 1.15rem;
    filter: blur(5px);
    user-select: none;
    pointer-events: none;
    opacity: 0.72;
  }

  .career-soon-line {
    height: 0.7rem;
    margin: 0 0 0.55rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--foreground) 14%, transparent);
  }

  .career-soon-line--lg {
    width: 42%;
    height: 0.85rem;
    margin-bottom: 0.75rem;
    background: color-mix(in srgb, var(--foreground) 20%, transparent);
  }

  .career-soon-line--md {
    width: 68%;
  }

  .career-soon-line:nth-child(2) {
    width: 88%;
  }

  .career-soon-dots {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .career-soon-dots li {
    height: 0.55rem;
    width: 78%;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--foreground) 12%, transparent);
  }

  .career-soon-dots li:nth-child(2) {
    width: 64%;
  }

  .career-soon-dots li:nth-child(3) {
    width: 71%;
  }

  .career-soon-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--foreground);
    background: color-mix(in srgb, var(--background) 35%, transparent);
  }
</style>
