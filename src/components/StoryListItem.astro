---
import NoteThumbnail from "./NoteThumbnail.astro";
import { getNotePathSlug } from "../utils/notion";
import { formatArticleDate } from "../utils/formatDate";
import type { NoteData } from "../utils/notion";

interface Props {
  note: NoteData;
  /** 목록 상단 항목은 즉시 로드 */
  eager?: boolean;
}

const { note, eager = false } = Astro.props;
---

<a
  href={`/notes/${getNotePathSlug(note)}`}
  class="story-row flex flex-col gap-2 rounded-xl outline-offset-4"
>
  <time
    class="text-muted text-sm leading-[1.4]"
    datetime={new Date(note.pubDate).toISOString()}
  >
    {formatArticleDate(note.pubDate)}
  </time>
  <div class="flex flex-col gap-3">
    <h3 class="story-title text-base leading-[1.5] font-medium">
      {note.title}
    </h3>
    <NoteThumbnail
      image={note.image}
      title={note.title}
      variant="list"
      loading={eager ? "eager" : "lazy"}
    />
  </div>
</a>
