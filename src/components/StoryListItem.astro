---
import NoteThumbnail from "./NoteThumbnail.astro";
import { getNotePathSlug } from "../utils/notion";
import { formatStoryDate } from "../utils/formatDate";
import type { NoteData } from "../utils/notion";

interface Props {
  note: NoteData;
  /** 연도별 섹션 등에서 제목 옆 날짜에 연도를 빼고 월·일만 표시 */
  omitYear?: boolean;
}

const { note, omitYear = false } = Astro.props;
const summary = note.excerpt || note.description;
const displayTags = note.tags?.slice(0, 2) ?? [];
---

<a href={`/notes/${getNotePathSlug(note)}`} class="story-row">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-5">
    <NoteThumbnail image={note.image} title={note.title} variant="list" />
    <div class="flex min-w-0 flex-1 flex-col gap-2">
      <div class="flex items-start justify-between gap-4">
        <span class="story-title min-w-0 text-base font-semibold leading-snug">
          {note.title}
        </span>
        <time
          class="story-row__date shrink-0 text-sm font-medium text-muted tabular-nums"
          datetime={new Date(note.pubDate).toISOString()}
        >
          {formatStoryDate(note.pubDate, { omitYear })}
        </time>
      </div>
      {
        summary && (
          <p class="story-summary line-clamp-2 text-sm text-muted opacity-80">
            {summary}
          </p>
        )
      }
      {
        displayTags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {displayTags.map(tag => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</a>
