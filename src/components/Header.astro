---
import Navigation from "./Navigation.astro";
---

<header
  class="pointer-events-none fixed top-[var(--dock-top)] right-0 left-0 z-50 flex justify-center px-[var(--space-content)]"
>
  <nav
    class="pointer-events-auto flex items-center gap-0.5 rounded-full border border-[var(--border)] bg-[color-mix(in_srgb,var(--background)_82%,transparent)] p-1 shadow-[0_1px_2px_rgb(0_0_0/0.04)] backdrop-blur-[16px]"
    aria-label="주요 메뉴"
  >
    <Navigation />
  </nav>
</header>
