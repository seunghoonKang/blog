---
interface Props {
  image?: { url: string; alt: string };
  title: string;
  variant?: "list" | "hero";
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  image,
  title,
  variant = "list",
  loading = "lazy",
  fetchpriority,
} = Astro.props;

const isHero = variant === "hero";
const alt = image?.alt || (isHero ? `${title} 커버` : title);
---

{
  image && (
    <div
      class:list={[
        "media-thumb relative w-full overflow-hidden rounded-xl bg-[var(--muted)]",
        isHero ? "" : "story-thumb h-[200px]",
      ]}
    >
      <img
        src={image.url}
        alt={alt}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        onload="this.parentElement.dataset.loaded = ''"
        onerror="this.parentElement.dataset.loaded = ''"
        class:list={[
          "block w-full",
          isHero ? "h-auto max-h-[70vh] object-contain" : "h-full object-cover",
        ]}
      />
      {!isHero && <div class="media-shimmer" aria-hidden="true" />}
    </div>
  )
}

<script>
  // 캐시된 이미지는 hydration 전에 load가 끝나 onload를 놓칠 수 있음
  document
    .querySelectorAll<HTMLImageElement>(".media-thumb img")
    .forEach(img => {
      if (img.complete && img.parentElement)
        img.parentElement.dataset.loaded = "";
    });
</script>
